# Caddy reverse proxy for the Trap Garden.
# Auto-HTTPS via Let's Encrypt, passes X-Forwarded-Proto so the garden
# knows to mark cookies Secure. Replace DOMAIN with the real domain.

DOMAIN {
	encode gzip

	# Boring, standard proxy headers; nothing exotic for visitors to smell
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-Proto {scheme}
	}

	# Quiet the server header; Caddy is common enough not to matter,
	# but consistency helps the cover.
	header {
		-Server
	}

	log {
		output file /var/log/caddy/access.log
	}
}
